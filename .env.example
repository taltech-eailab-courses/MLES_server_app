# Copy to .env (git-ignored) and fill in. Read by docker compose.

# HTTPS URL of the robot-planner model on S3 (public object URL, or a presigned URL)
ROBOT_PLANNER_URL=https://mles-lab.s3.ap-northeast-1.amazonaws.com/models/robot-q4_k_m.gguf

# Optional but recommended: output of `shasum -a 256 robot-q4_k_m.gguf`
ROBOT_PLANNER_SHA256=

# Existing setting used by the ngrok service
NGROK_AUTHTOKEN=
